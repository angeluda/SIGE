    id_proveedor    INT UNSIGNED NOT NULL,
    cedula          VARCHAR(10)  NOT NULL,

    CONSTRAINT pk_ppn            PRIMARY KEY (id_proveedor),
    CONSTRAINT uq_ppn_cedula     UNIQUE      (cedula),
    CONSTRAINT fk_ppn_proveedor  FOREIGN KEY (id_proveedor)
